<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Runs `msx run` every 30 minutes on the ONE Mac designated as the poster.
       Install:  cp deploy/launchd/uk.co.digivolve.msx.plist ~/Library/LaunchAgents/
                 sed -i '' "s#__REPO__#$HOME/Moneysoftpayrolljournalsxero#g" ~/Library/LaunchAgents/uk.co.digivolve.msx.plist
                 launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/uk.co.digivolve.msx.plist
       Logs:     ~/.config/msx/launchd.log
       A run is idempotent, so a 30-minute cadence costs nothing when there is
       nothing new; it also refreshes the Xero token well inside the 60-day
       refresh-token life and writes the heartbeat. Best hosted on an
       always-on Mac (a Mac mini as "the payroll machine"): set Energy Saver
       to never sleep and "Start up automatically after a power failure". -->
  <key>Label</key>
  <string>uk.co.digivolve.msx</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/bin/msx</string>
    <string>run</string>
  </array>
  <!-- Calendar triggers (not StartInterval): Apple documents that a
       StartCalendarInterval job missed during sleep runs at wake, whereas
       StartInterval firings during sleep are simply dropped. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>5</integer></dict>
    <dict><key>Minute</key><integer>35</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/.config/msx/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/.config/msx/launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
