+@app.route(route="msx/xero/{*path}", methods=["GET", "PUT", "POST"],
+           auth_level=func.AuthLevel.FUNCTION)
+def msx_xero(req: func.HttpRequest) -> func.HttpResponse:
+    """Scoped Xero pass-through for the payroll journal pipeline (msx).
+
+    Two locks before anything is forwarded: Easy Auth must have admitted the
+    Payroll Agent Client app (same check as /api/post-journal) and the
+    function key must match. Then shared.msx_proxy decides whether the call
+    is on the allow-list; Xero's answer comes back verbatim.
+    """
+    c = Clients()
+    if principal_app_id(req.headers) != c.cfg.payroll_agent_app_id:
+        return func.HttpResponse(json.dumps({"Title": "Forbidden",
+                                             "Detail": "unauthorised client"}),
+                                 status_code=403, mimetype="application/json")
+    body = None
+    if req.method in ("PUT", "POST"):
+        try:
+            body = req.get_json()
+        except ValueError:
+            return func.HttpResponse(json.dumps({"Title": "Bad Request",
+                                                 "Detail": "body is not JSON"}),
+                                     status_code=400, mimetype="application/json")
+    tenant = (req.headers.get("Xero-Tenant-Id") or req.headers.get("xero-tenant-id")
+              or "").strip()
+
+    def org_lookup(tid):
+        try:
+            return registry.get_org(c.tables["orgs"], tid)
+        except Exception:
+            return None
+
+    try:
+        path, params = msx_proxy.decide(req.method, req.route_params.get("path", ""),
+                                        dict(req.params), tenant, body, org_lookup)
+    except msx_proxy.Refusal as r:
+        return func.HttpResponse(json.dumps({"Title": "Refused by the msx pass-through",
+                                             "Detail": r.reason}),
+                                 status_code=r.status, mimetype="application/json")
+    status, headers, text = c.xero.forward(
+        req.method, path, tenant_id=tenant or None, params=params, body=body,
+        idempotency_key=req.headers.get("Idempotency-Key"))
+    out = {k: v for k, v in headers.items() if k in msx_proxy.PASS_HEADERS}
+    return func.HttpResponse(text, status_code=status, headers=out,
+                             mimetype="application/json")
+
+
 @app.timer_trigger(schedule="0 0 2 * * *", arg_name="timer")
