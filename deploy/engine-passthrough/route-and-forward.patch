     def connections(self):
         return self._request("GET", CONNECTIONS)
 
+    def forward(self, method, path, tenant_id=None, params=None, body=None,
+                idempotency_key=None):
+        """One call, Xero's answer returned verbatim: (status, headers, text).
+
+        For the msx pass-through: the caller owns retry, 429 back-off and
+        error text, so nothing is raised on 4xx/5xx and nothing is retried
+        here beyond one token refresh on 401. Paced per tenant like every
+        other call so the shared quota is respected.
+        """
+        url = CONNECTIONS if path == "connections" else API + path
+        refreshed = False
+        while True:
+            if tenant_id:
+                self._pace(tenant_id)
+            headers = {"Authorization": f"Bearer {self.tokens.get_access_token()}",
+                       "Accept": "application/json"}
+            if tenant_id:
+                headers["Xero-tenant-id"] = tenant_id
+            if idempotency_key:
+                headers["Idempotency-Key"] = idempotency_key
+            r = requests.request(method, url, headers=headers, params=params,
+                                 timeout=60, **({"json": body} if body is not None else {}))
+            if r.status_code == 401 and not refreshed:
+                refreshed = True
+                continue
+            return r.status_code, dict(r.headers), r.text
+
     def get(self, tenant_id, path, params=None, if_modified_since=None):
         return self._request("GET", API + path, tenant_id, params, if_modified_since)
 
